# ============================================================
# 複製這個檔案成 .env.local,填入你的 Supabase 專案資訊
# .env.local 已經在 .gitignore 裡,不會被提交上 GitHub
# ============================================================

# Supabase 專案設定 → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase 專案設定 → API → Project API keys → anon / public
# 這把金鑰會出現在瀏覽器,是設計上可公開的;真正的防護靠資料庫的 RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ------------------------------------------------------------
# 以下只給每日同步腳本(GitHub Actions)使用,不要放進網站前端
# ------------------------------------------------------------

# Supabase 專案設定 → API → Project API keys → service_role
# 這把金鑰可以繞過所有 RLS,務必只存在 GitHub Secrets,絕不提交進版控
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
